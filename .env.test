# Example deployment values only. Do not commit real credentials.
RW_DOTNET_IMAGE=docker.io/your-dockerhub-user/realworld-dotnet
RW_DOTNET_IMAGE_TAG=dotnet-10-aspnetcore
RW_DOTNET_APP_ORIGIN=https://realworld.example.com
RW_DOTNET_ALLOWED_HOSTS=realworld.example.com

POSTGRES_DB=realworld
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-admin-password
APP_DB_USER=realworld_app
APP_DB_PASSWORD=replace-with-a-long-url-safe-app-password

GATEWAY_DB_USER=realworld_reader
# Keep database passwords URL-safe because Gateway receives a PostgreSQL URL.
GATEWAY_DB_PASSWORD=replace-with-another-long-url-safe-password
GATEWAY_MASTERPASS=replace-with-a-long-random-master-password
GATEWAY_BIND_PORT=4983
DRIZZLE_GATEWAY_IMAGE=ghcr.io/drizzle-team/gateway:latest
# Leave blank normally. Set to tools only while you need the database browser.
COMPOSE_PROFILES=

JWT_SECRET=replace-with-at-least-64-random-characters

R2_ACCESS_KEY=replace-me
R2_SECRET_KEY=replace-me
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=realworld
R2_DOMAIN=https://assets.example.com

# The Aspire dashboard stores telemetry in memory and is intended for live diagnostics.
ASPIRE_DASHBOARD_IMAGE=mcr.microsoft.com/dotnet/aspire-dashboard:latest
ASPIRE_DASHBOARD_OTLP_API_KEY=replace-with-a-long-random-api-key
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
